@@ -3,7 +3,14 @@ import UIKit
 class ImageViewerRootView: UIView, RootViewType {
     let transition = MatchTransition()
 
-    weak var imageDatasource: ImageDataSource?
+    // Patched: was `weak`, which caused the source `TapWithDataRecognizer` to be
+    // the only strong owner of the datasource. `GaleriaView.setupImageView()`
+    // removes & recreates that recognizer on every prop update (Fabric view
+    // recycling). When the parent re-renders while the lightbox is open the
+    // datasource gets deallocated, `UIPageViewController` dataSource methods
+    // return nil, and swipe navigation between pages breaks. Holding it
+    // strongly here ties the lifetime to the viewer itself.
+    var imageDatasource: ImageDataSource?
     let imageLoader: ImageLoader
     var initialIndex: Int = 0
     var theme: ImageViewerTheme = .dark
